  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#AACFD166", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "punctuation.definition.string"],
      "settings": { "foreground": "#8FD1A8" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#D1C48F" }
    },
    {
      "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#B08FD1" }
    },
    {
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#C8E6E7" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#C8E6E7" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "#7FA8D1" }
    },
    {
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "#AACFD1" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#CFE4E5" }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#B08FD1" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#D1C48F" }
    },
    {
      "scope": ["support.type.property-name", "meta.object-literal.key"],
      "settings": { "foreground": "#AACFD1" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#D1706A" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#C8E6E7", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#8FD1A8" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#D1706A" }
    }
  ]
}
