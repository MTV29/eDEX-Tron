* text=auto
# Windows PowerShell 5.1 and Rainmeter expect CRLF
*.ps1   text eol=crlf
*.ini   text eol=crlf
*.inc   text eol=crlf
*.txt   text eol=crlf
# binary assets
*.ico   binary
*.png   binary
*.jpg   binary
*.ttf   binary
*.exe   binary
# the Linux edition runs on Linux: LF everywhere (listed last so it wins)
linux/**        text eol=lf
linux/**/*.png  binary
linux/**/*.jpg  binary
